{
  "name": "menna-flow-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --persist-to ../.wrangler/state",
    "migrate:local": "wrangler d1 migrations apply menna-flow --local --persist-to ../.wrangler/state",
    "migrate:remote": "wrangler d1 migrations apply menna-flow --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.142.0"
  }
}
